# ---- Secrets and local configuration ----
# Real API keys live in .env files, which must never be committed.
.env
.env.*
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/

# ---- Node / frontend ----
node_modules/
dist/
*.log

# ---- DocuMind runtime data ----
# Uploaded PDFs, the SQLite database and ChromaDB vectors stay on your machine only.
backend/storage/
*.db
*.db-wal
*.db-shm
*.sqlite3

# ---- Evaluation reports ----
# Reports stay local; only the reviewed baseline is committed.
backend/evals/reports/*
!backend/evals/reports/baseline.json

# ---- Editors and operating system ----
.vscode/
.idea/
.DS_Store
Thumbs.db