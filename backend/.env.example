# Copy this file to .env (in the same folder) and change values for your machine.
# .env is ignored by Git. Never commit real secrets.

# Browser origins allowed to call the API, separated by commas.
# Development: the Vite dev server. In production, set the frontend's real address.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173